// poche — agent-first output contract (cli-output-spec).
// stdout = data JSON; stderr = typed errors; exit codes 80–119.

func jesc_p(s) (out) {
    out = replace(s, "\\", "\\\\")
    out = replace(out, "\"", "\\\"")
    out = replace(out, "\n", "\\n")
    out = replace(out, "\t", "\\t")
}

func eprint(s) { n := write(2, s + "\n") }

func out_ok(dataJson) {
    println("{\"ok\":true,\"version\":\"" + poche_version() + "\",\"data\":" + dataJson + "}")
    // Every successful command exits through here, so this is the one place
    // telemetry can report from — and the right one: the result is already
    // written, so the report cannot delay or corrupt it.
    tel_report(tel_verb_from_args(), 0)
    exit(0)
}

func out_ok_keep(dataJson) {
    println("{\"ok\":true,\"version\":\"" + poche_version() + "\",\"data\":" + dataJson + "}")
}

func out_err(code, typ, msg, suggestion) {
    rec := "false"
    if code >= 100 && code < 110 { rec = "true" }
    sug := ""
    if len(suggestion) > 0 { sug = ",\"suggestions\":[\"" + jesc_p(suggestion) + "\"]" }
    eprint("{\"ok\":false,\"error\":{\"code\":" + str(code) + ",\"type\":\"" + typ + "\",\"message\":\"" + jesc_p(msg) + "\",\"recoverable\":" + rec + sug + "}}")
    exit(code)
}

func unq(s) (r) {
    r = s
    if len(s) < 2 || substr(s, 0, 1) != "\"" { return }
    r = ""
    i := 1
    stop := len(s) - 1
    while i < stop {
        c := charat(s, i)
        if c == "\\" && i + 1 < stop {
            n := charat(s, i + 1)
            if n == "n" { r = r + "\n" }
            else if n == "r" { r = r + "\r" }
            else if n == "t" { r = r + "\t" }
            else if n == "\"" { r = r + "\"" }
            else if n == "\\" { r = r + "\\" }
            else { r = r + "\\" + n }
            i = i + 2
        } else {
            r = r + c
            i = i + 1
        }
    }
}

// g_tenant_db set by cloud.src when a pt_ tenant token is active
var g_tenant_db = ""
var g_cloud_admin = 0

func poche_db() (d) {
    if len(g_tenant_db) > 0 { d = g_tenant_db  return }
    d = env("POCHE_DB")
    if len(d) == 0 { d = "./poche.data" }
}
